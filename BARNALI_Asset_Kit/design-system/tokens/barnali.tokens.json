{
  "name": "BARNALI Design System",
  "version": "1.1.0",
  "brand": {
    "forestGreen": "#073B2A",
    "electricTeal": "#00AEBB",
    "warmIvory": "#F9F5EA",
    "vermilion": "#E65336",
    "ink": "#17221D"
  },
  "semantic": {
    "primary": "#073B2A",
    "primaryHover": "#0A4A35",
    "accent": "#00AEBB",
    "accentText": "#007780",
    "background": "#F9F5EA",
    "surface": "#FFFFFF",
    "text": "#17221D",
    "textMuted": "#68736B",
    "border": "#DCDDD2",
    "selected": "#D7F1EF",
    "navigationSelected": "#E7EEE7",
    "success": "#216E4A",
    "successBg": "#E4F3E9",
    "warning": "#79520A",
    "warningBg": "#FFF3D8",
    "danger": "#A83220",
    "dangerBg": "#FCE8E3"
  },
  "typography": {
    "display": "Georgia, 'Times New Roman', serif",
    "body": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "scale": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px",
      "3xl": "40px"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px"
  },
  "radii": {
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "24px",
    "pill": "999px"
  },
  "breakpoints": {
    "mobile": {
      "min": 320,
      "max": 639
    },
    "tablet": {
      "min": 640,
      "max": 1023
    },
    "desktop": {
      "min": 1024
    }
  },
  "layout": {
    "contentMaxWidth": "1600px",
    "mobileColumns": 1,
    "tabletColumns": 2,
    "desktopColumns": 3
  },
  "motion": {
    "durationFast": "120ms",
    "durationStandard": "200ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "usage": {
    "neutralSurfaces": "70%",
    "brandGreen": "20%",
    "accentColorsCombined": "10%"
  },
  "accessibility": {
    "minimumTouchTarget": "44px",
    "focusRing": "3px solid #00AEBB",
    "smallTextOnBrightTeal": "Use #007780 instead of #00AEBB"
  }
