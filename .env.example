# Server-side PostgreSQL connection. The default below is local-only (loopback).
# For Supabase shared Session Pooler, copy the exact host from the Dashboard Connect dialog,
# use port 5432 and sslmode=require, and set DATABASE_USERNAME to postgres.<PROJECT-REF>
# (or <CUSTOM-ROLE>.<PROJECT-REF>). Keep the password in DATABASE_PASSWORD, not in the URL.
# Example shape: jdbc:postgresql://<POOLER-HOST>:5432/postgres?sslmode=require
# Runtime, migration, and owner-provisioner credentials must be separate. No credential
# falls back to another principal.

# Application environment: dev or prod. Production requires HTTPS and a strong HMAC key.
APP_ENV=dev
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
SESSION_COOKIE_SECURE=false
APP_SECURITY_HMAC_KEY=

# One-time owner bootstrap. The bootstrap password is never stored in this file.
OWNER_EMAIL=banerjeeshubham00@gmail.com
OWNER_BOOTSTRAP_PASSWORD=
# Execute-only role used only by the isolated one-shot owner command.
OWNER_PROVISIONER_DATABASE_URL=jdbc:postgresql://<SESSION-POOLER-HOST>:5432/postgres?sslmode=require
OWNER_PROVISIONER_DATABASE_USERNAME=barnali_provisioner.<PROJECT-REF>
OWNER_PROVISIONER_DATABASE_PASSWORD=

# Optional SMTP recovery/invitation delivery. Leave unset to use owner-only, single-use
# invitation links and to report password recovery as unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Optional Nuxt server-side API base. Browser requests use the public URL below.
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Replace these placeholders locally; keep this template free of credentials.
DATABASE_URL=jdbc:postgresql://<SESSION-POOLER-HOST>:5432/postgres?sslmode=require
DATABASE_USERNAME=barnali_runtime.<PROJECT-REF>
DATABASE_PASSWORD=
MIGRATION_DATABASE_URL=jdbc:postgresql://<SESSION-POOLER-HOST>:5432/postgres?sslmode=require
MIGRATION_DATABASE_USERNAME=barnali_migrator.<PROJECT-REF>
MIGRATION_DATABASE_PASSWORD=
BARNALI_EXPECTED_SUPABASE_PROJECT_REF=<PROJECT-REF>
